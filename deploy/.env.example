# Copy to deploy/.env before `make compose-up`; deploy/.env is gitignored.
#   cp deploy/.env.example deploy/.env
#   printf 'NEXO_AUTH_NATIVE_SECRET=%s\n' "$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')" >> deploy/.env

# HMAC key for native login tokens. Required, >= 32 chars, never commit a real one.
NEXO_AUTH_NATIVE_SECRET=

# Password for the throwaway compose database; used by both the server DSN and the db container.
NEXO_PG_PASSWORD=nexo
NEXO_MYSQL_PASSWORD=nexo
